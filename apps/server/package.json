{
  "name": "@dynamo-studio/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --max-old-space-size=128 --import tsx --watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --max-old-space-size=128 dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1156.0",
    "@aws-sdk/credential-providers": "^3.1155.0",
    "@dynamo-studio/shared": "workspace:*",
    "@fastify/cookie": "^11.1.3",
    "@fastify/multipart": "^10.1.6",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.7",
    "fastify": "^5.12.7",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "fast-check": "^4.10.2",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15"
  }
}
