{
  "name": "dynamo-studio",
  "private": true,
  "version": "1.0.0-rc.1",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:db": "docker compose up -d dynamodb-local",
    "seed": "tsx scripts/seed-data.ts",
    "lint": "eslint . && prettier --check .",
    "typecheck": "tsc -b && tsc -p scripts/tsconfig.json --noEmit && tsc -p tsconfig.tools.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:int": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "build": "pnpm --filter @dynamo-studio/shared build && pnpm --filter @dynamo-studio/server build && pnpm --filter @dynamo-studio/web build && tsx scripts/check-design-bundle.ts && tsx scripts/check-bundle.ts && tsx scripts/check-bundle-size.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:int && pnpm build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1156.0",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
